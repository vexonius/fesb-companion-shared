platform :ios do

  # Shared Private Lane Helpers for reuse in the main lane
  #############################
  # Shared Private Lane Helpers
  #############################

  release_type = ENV['RELEASE_TYPE']

  private_lane :setup_ci_if_needed do
    unless ENV['CI']
      UI.message("🖥️ Running locally, skipping CI-specific setup.")
    else
      setup_ci(
        provider: "circleci"
      )
    end
  end

  private_lane :load_api_key do |options|
    app_store_connect_api_key(
      key_id: options[:appstore_key_id],
      issuer_id: options[:appstore_issuer_id],
      key_filepath: options[:key_filepath],
      duration: 1200  # Token validity (seconds)
    )
  end

  private_lane :fetch_certificates_with_match do |options|
    match(
      type: options[:match_type],
      app_identifier: options[:app_identifier],
      readonly: true,  # Don't generate new if not needed
      git_url: options[:git_url],
      git_branch: options[:git_branch],
      git_private_key: options[:git_private_key],
      force_for_new_devices: false,  # Renew profile if new devices added
      api_key: Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]  # Use API key for auth
    )
  end

  private_lane :build_ios_project do |options|
    app_identifier = options[:app_identifier]
    provisioning_profile_name = options[:provisioning_profile_name]

    gradle(
  project_dir: "..",
  tasks: [":composeApp:assembleComposeAppReleaseXCFramework"]
)

    build_ios_app(
      scheme: "iosApp",                                            # Your Xcode scheme name
      project: "iosApp.xcodeproj",                                 # Path to your .xcodeproj
      output_name: "iosApp.ipa",                                   # Name of the .ipa file generated
      output_directory: File.expand_path("../build", __dir__),     # Output directory for the .ipa
      export_options: {                                            # Export options for code signing
        provisioningProfiles: {
          app_identifier => provisioning_profile_name              # Specify the provisioning profile to use
        }
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" DEVELOPMENT_TEAM=5S598DJMXN PROVISIONING_PROFILE_SPECIFIER=\"#{provisioning_profile_name}\""
      # ^ Extra Xcode build settings to force manual code signing with the specified provisioning profile.
    )
  end

  desc "Upload iOS Application to App Store"
  lane :release do |options|
    setup_ci_if_needed  # If running on CI, perform any CI-specific setup.
    load_api_key(options)  # Authenticate with App Store Connect API using the key.
    fetch_certificates_with_match(options.merge(match_type: "appstore"))  # Pull App Store signing certs/profiles.

    increment_version_number(
      xcodeproj: "iosApp.xcodeproj",
      version_number: "1.0.0"
    )

    # Fetch the most recent build number uploaded to TestFlight (to avoid duplicates).
    latest_build_number = latest_testflight_build_number(
      app_identifier: options[:app_identifier],
      api_key: Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )

    # Increment the build number in Xcode project to one higher than the latest TestFlight build.
    increment_build_number(
      xcodeproj: "iosApp.xcodeproj",
      build_number: latest_build_number + 1
    )

    # Update certain Info.plist entries (example shown for usage descriptions).
    update_plist(
      plist_path: "iosApp/Info.plist",
      block: proc do |plist|
        plist['NSContactsUsageDescription'] = 'This app requires access to your contacts to enable autofill and collaboration features.'
        plist['NSLocationWhenInUseUsageDescription'] = 'This app does not use your location to suggest services near you.'
        plist['NSBluetoothAlwaysUsageDescription'] = 'This app does not use Bluetooth to communicate with nearby devices.'
      end
    )

    # Build the iOS app using the App Store provisioning profile (generates an IPA).
    build_ios_project(
      options.merge(provisioning_profile_name: "match AppStore com.tstudioz.fax.fme 1779911279")
    )
    # Choose distribution target (TestFlight vs App Store)
    case release_type
    when 'appstore'
      UI.message("🚀 Uploading to App Store (via deliver)")

      # Upload the build and metadata to App Store Connect, then submit for review and release.
      deliver(
        metadata_path: options[:metadata_path],  # Path to metadata folder
        submit_for_review: false,        # Automatically submit the build for App Store review
        automatic_release: false,        # Automatically release the app once approved (skip manual release)
        api_key: Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],  # Use API key for App Store Connect
        skip_app_version_update: true,  # Don’t attempt to create a new app version in App Store Connect
        force: true,                    # Skip confirmation dialogs and HTML report checks
        precheck_include_in_app_purchases: false,  # Skip automatic in-app purchase checks
        overwrite_screenshots: true,    # Overwrite existing screenshots on App Store Connect
        app_rating_config_path: options[:app_rating_config_path],
        submission_information: {
          add_id_info_uses_idfa: false,
          add_id_info_limits_tracking: false,
          add_id_info_serves_ads: false,
          add_id_info_tracks_action: false,
          add_id_info_tracks_install: false,
          content_rights_has_rights: true,
          content_rights_contains_third_party_content: false,
          export_compliance_platform: 'ios',
          export_compliance_compliance_required: false,
          export_compliance_encryption_updated: false,
          export_compliance_app_type: nil,
          export_compliance_uses_encryption: false,
          export_compliance_is_exempt: true,
          export_compliance_contains_third_party_cryptography: false,
          export_compliance_contains_proprietary_cryptography: false,
          export_compliance_available_on_french_store: true
        }
      )
    when 'testflight'
      UI.message("🧪 Uploading to TestFlight")
    
      upload_to_testflight(
        ipa: "iosApp/build/iosApp.ipa",
        api_key: Actions.lane_context[:app_store_connect_api_key],
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    when 'none'
      UI.message("⏭️ Skipping upload (build only mode)")
    end
  end
end
